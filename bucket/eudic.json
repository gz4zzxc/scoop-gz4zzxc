{
    "version": "26.9.0.0",
    "description": "权威英语词典软件，支持屏幕取词与真人发音",
    "homepage": "https://www.eudic.net/",
    "license": "Proprietary",
    "notes": [
        "欧路词典官方桌面客户端",
        "支持单词真人发音、英语翻译、跨软件取词等功能",
        "内置权威英语词典，支持离线查词",
        "支持生词本、笔记、荧光笔标记等学习功能",
        "多平台同步，支持学习记录云端同步",
        "安装后可在开始菜单中找到欧路词典快捷方式"
    ],
    "architecture": {
        "64bit": {
            "url": "https://www.eudic.net/download/eudic_win.zip?v=26.9.0#/eudic_win.zip",
            "hash": "76089ab96fbe8fecd33be3135f0ea0f3ef845d137480cdedd20c65b8fae85152"
        }
    },
    "installer": {
        "script": [
            "Write-Host 'Installing 欧路词典...' -ForegroundColor Green",
            "# Extract the eudic_win.exe using 7zip",
            "if (Test-Path \"$dir\\eudic_win.exe\") {",
            "    Write-Host 'Extracting eudic_win.exe...' -ForegroundColor Cyan",
            "    Expand-7ZipArchive \"$dir\\eudic_win.exe\" \"$dir\\\" -Removal",
            "    if (Test-Path \"$dir\\app.7z\") {",
            "        Write-Host 'Extracting app.7z...' -ForegroundColor Cyan",
            "        Expand-7ZipArchive \"$dir\\app.7z\" \"$dir\" -Removal",
            "    }",
            "    # Clean up unnecessary files",
            "    @('uninst.exe.nsis', '$PLUGINSDIR') | ForEach-Object {",
            "        if (Test-Path \"$dir\\$_\") {",
            "            Remove-Item \"$dir\\$_\" -Force -Recurse -ErrorAction SilentlyContinue",
            "        }",
            "    }",
            "    Write-Host '✓ 欧路词典 installation completed.' -ForegroundColor Green",
            "} else {",
            "    Write-Host '✗ eudic_win.exe not found, installation failed' -ForegroundColor Red",
            "    throw 'eudic_win.exe not found, installation failed'",
            "}"
        ]
    },
    "bin": "eudic.exe",
    "shortcuts": [
        [
            "eudic.exe",
            "欧路词典"
        ]
    ],
    "post_install": [
        "Write-Host '欧路词典已安装完成！' -ForegroundColor Cyan",
        "Write-Host '您可以在开始菜单中找到欧路词典快捷方式' -ForegroundColor Yellow",
        "Write-Host '首次使用建议登录账号以同步学习记录' -ForegroundColor Yellow",
        "Write-Host '支持跨软件取词、划词搜索等便捷功能' -ForegroundColor Yellow"
    ],
    "checkver": {
        "url": "https://www.eudic.net/v4/en/app/download",
        "script": [
            "$pageUrl = 'https://www.eudic.net/v4/en/app/download'",
            "$userAgent = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/131.0.0.0 Safari/537.36'",
            "$page = (Invoke-WebRequest -UseBasicParsing -Uri $pageUrl -UserAgent $userAgent -MaximumRedirection 10 -ErrorAction Stop).Content",
            "$match = [regex]::Match($page, '(?i)href\\s*=\\s*[\"''](?<url>[^\"'']*eudic_win\\.zip[^\"'']*)[\"'']')",
            "if (-not $match.Success) { throw 'Could not find the Windows Eudic download link on the official page' }",
            "$downloadUrl = [System.Uri]::new([System.Uri]$pageUrl, $match.Groups['url'].Value).AbsoluteUri",
            "$downloadUrl = $downloadUrl -replace '#.*$', ''",
            "$tmp = cache_path 'eudic' '64bit' 'https://www.eudic.net/download/eudic_win.zip'",
            "Invoke-WebRequest -UseBasicParsing -Uri $downloadUrl -UserAgent $userAgent -MaximumRedirection 10 -OutFile $tmp -ErrorAction Stop",
            "$dest = Join-Path (Split-Path $tmp) 'eudic_extract'",
            "if (Test-Path -LiteralPath $dest) { Remove-Item -LiteralPath $dest -Recurse -Force -ErrorAction Stop }",
            "Add-Type -AssemblyName System.IO.Compression.FileSystem",
            "[System.IO.Compression.ZipFile]::ExtractToDirectory($tmp, $dest)",
            "$exe = Get-ChildItem -LiteralPath $dest -Recurse -Filter 'eudic_win.exe' -File | Select-Object -First 1",
            "if (-not $exe) { throw 'eudic_win.exe not found in zip' }",
            "$product = (Get-Item $exe.FullName).VersionInfo.ProductVersion",
            "$file = (Get-Item $exe.FullName).VersionInfo.FileVersion",
            "if (-not $product) { throw 'Cannot read ProductVersion from eudic_win.exe' }",
            "Write-Host ('eudic VersionInfo => ProductVersion=' + $product + '; FileVersion=' + $file + '; URL=' + $downloadUrl) -ForegroundColor Yellow",
            "Write-Output ($product + '|' + $downloadUrl)"
        ],
        "regex": "(?<version>\\d+(?:\\.\\d+){3})\\|(?<url>https://[^|]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchUrl#/eudic_win.zip"
            }
        },
        "hash": {
            "mode": "download"
        }
    }
}
